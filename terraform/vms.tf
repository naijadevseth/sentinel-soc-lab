# =============================================================================
# Sentinel SOC Lab - Phase 1b: monitored machines
#
# One Windows Server and one Ubuntu VM on a private network. Remote access
# (RDP / SSH) is allowed ONLY from my own IP address. The Azure Monitor Agent
# on each VM ships security logs into the Sentinel workspace from main.tf.
# Both VMs are deallocated automatically every night to protect the credit.
# =============================================================================

variable "my_ip" {
  description = "Your public IP in CIDR form, e.g. 102.89.1.2/32. The only address allowed to RDP/SSH in."
  type        = string
}

variable "ssh_public_key_path" {
  description = "Public half of the SSH key used to log in to the Linux VM"
  type        = string
  default     = "~/.ssh/id_ed25519.pub"
}

variable "alert_email" {
  description = "Email for lab notifications"
  type        = string
}

locals {
  # VMs run in Austria East: the only allowed region where this subscription
  # has BOTH the VM size available AND CPU quota for it (France Central offers
  # only v7 sizes, which have 0 quota). Sentinel, the workspace and the data
  # collection rules stay in France Central; logs travel across regions.
  vm_location    = "austriaeast"
  vm_size        = "Standard_B2als_v2" # 2 vCPU, 4 GB RAM, burstable (Basv2 family, 10 cores of quota)
  admin_username = "socadmin"
  shutdown_tz    = "W. Central Africa Standard Time" # Lagos time
}

# -----------------------------------------------------------------------------
# Windows admin password: generated by Terraform, never typed or committed.
# It lives only in terraform.tfstate, which .gitignore keeps out of Git.
# -----------------------------------------------------------------------------

resource "random_password" "windows_admin" {
  length           = 24
  special          = true
  override_special = "!@#%*-_=+"
}

# -----------------------------------------------------------------------------
# Network
# -----------------------------------------------------------------------------

resource "azurerm_virtual_network" "lab" {
  name                = "vnet-soc-lab"
  location            = local.vm_location
  resource_group_name = azurerm_resource_group.lab.name
  address_space       = ["10.10.0.0/16"]
  tags                = local.tags
}

resource "azurerm_subnet" "vms" {
  name                 = "snet-vms"
  resource_group_name  = azurerm_resource_group.lab.name
  virtual_network_name = azurerm_virtual_network.lab.name
  address_prefixes     = ["10.10.1.0/24"]
}

# Firewall rules for the subnet. Azure denies all other inbound internet
# traffic by default, so these two rules are the only way in.
resource "azurerm_network_security_group" "vms" {
  name                = "nsg-soc-lab-vms"
  location            = local.vm_location
  resource_group_name = azurerm_resource_group.lab.name
  tags                = local.tags

  security_rule {
    name                       = "allow-rdp-from-my-ip"
    priority                   = 100
    direction                  = "Inbound"
    access                     = "Allow"
    protocol                   = "Tcp"
    source_address_prefix      = var.my_ip
    source_port_range          = "*"
    destination_address_prefix = "*"
    destination_port_range     = "3389"
  }

  security_rule {
    name                       = "allow-ssh-from-my-ip"
    priority                   = 110
    direction                  = "Inbound"
    access                     = "Allow"
    protocol                   = "Tcp"
    source_address_prefix      = var.my_ip
    source_port_range          = "*"
    destination_address_prefix = "*"
    destination_port_range     = "22"
  }
}

resource "azurerm_subnet_network_security_group_association" "vms" {
  subnet_id                 = azurerm_subnet.vms.id
  network_security_group_id = azurerm_network_security_group.vms.id
}

resource "azurerm_public_ip" "win" {
  name                = "pip-win-soc-01"
  location            = local.vm_location
  resource_group_name = azurerm_resource_group.lab.name
  allocation_method   = "Static"
  sku                 = "Standard"
  tags                = local.tags
}

resource "azurerm_public_ip" "linux" {
  name                = "pip-lnx-soc-01"
  location            = local.vm_location
  resource_group_name = azurerm_resource_group.lab.name
  allocation_method   = "Static"
  sku                 = "Standard"
  tags                = local.tags
}

resource "azurerm_network_interface" "win" {
  name                = "nic-win-soc-01"
  location            = local.vm_location
  resource_group_name = azurerm_resource_group.lab.name
  tags                = local.tags

  ip_configuration {
    name                          = "primary"
    subnet_id                     = azurerm_subnet.vms.id
    private_ip_address_allocation = "Dynamic"
    public_ip_address_id          = azurerm_public_ip.win.id
  }
}

resource "azurerm_network_interface" "linux" {
  name                = "nic-lnx-soc-01"
  location            = local.vm_location
  resource_group_name = azurerm_resource_group.lab.name
  tags                = local.tags

  ip_configuration {
    name                          = "primary"
    subnet_id                     = azurerm_subnet.vms.id
    private_ip_address_allocation = "Dynamic"
    public_ip_address_id          = azurerm_public_ip.linux.id
  }
}

# -----------------------------------------------------------------------------
# Virtual machines
# Generation 2 images. Trusted Launch (Secure Boot + virtual TPM) protects
# against boot-level malware.
# -----------------------------------------------------------------------------

resource "azurerm_windows_virtual_machine" "win" {
  name                  = "win-soc-01"
  computer_name         = "win-soc-01"
  location              = local.vm_location
  resource_group_name   = azurerm_resource_group.lab.name
  size                  = local.vm_size
  admin_username        = local.admin_username
  admin_password        = random_password.windows_admin.result
  network_interface_ids = [azurerm_network_interface.win.id]
  secure_boot_enabled   = true
  vtpm_enabled          = true
  tags                  = local.tags

  # The Azure Monitor Agent signs in to Azure with this identity, so no
  # keys or passwords are stored on the VM.
  identity {
    type = "SystemAssigned"
  }

  os_disk {
    caching              = "ReadWrite"
    storage_account_type = "StandardSSD_LRS"
  }

  source_image_reference {
    publisher = "MicrosoftWindowsServer"
    offer     = "WindowsServer"
    sku       = "2022-datacenter-azure-edition"
    version   = "latest"
  }
}

resource "azurerm_linux_virtual_machine" "linux" {
  name                            = "lnx-soc-01"
  location                        = local.vm_location
  resource_group_name             = azurerm_resource_group.lab.name
  size                            = local.vm_size
  admin_username                  = local.admin_username
  disable_password_authentication = true # SSH keys only
  network_interface_ids           = [azurerm_network_interface.linux.id]
  secure_boot_enabled             = true
  vtpm_enabled                    = true
  tags                            = local.tags

  admin_ssh_key {
    username   = local.admin_username
    public_key = file(pathexpand(var.ssh_public_key_path))
  }

  identity {
    type = "SystemAssigned"
  }

  os_disk {
    caching              = "ReadWrite"
    storage_account_type = "StandardSSD_LRS"
  }

  source_image_reference {
    publisher = "Canonical"
    offer     = "ubuntu-24_04-lts"
    sku       = "server"
    version   = "latest"
  }
}

# -----------------------------------------------------------------------------
# Nightly auto-shutdown via a Logic App
#
# Azure's built-in auto-shutdown (Microsoft.DevTestLab/schedules) must live in
# the VM's region, and Austria East doesn't offer it. Instead, a Logic App in
# France Central runs every night at 22:00 Lagos time and calls the Azure API
# to deallocate both VMs. A deallocated VM costs nothing for compute.
#
# The Logic App signs in with its own managed identity (no stored secrets) and
# is only allowed to manage VMs in this resource group.
# -----------------------------------------------------------------------------

resource "azurerm_logic_app_workflow" "nightly_shutdown" {
  name                = "logic-nightly-vm-shutdown"
  location            = azurerm_resource_group.lab.location
  resource_group_name = azurerm_resource_group.lab.name
  tags                = local.tags

  identity {
    type = "SystemAssigned"
  }
}

resource "azurerm_logic_app_trigger_recurrence" "nightly" {
  name         = "every-night-2200"
  logic_app_id = azurerm_logic_app_workflow.nightly_shutdown.id
  frequency    = "Day"
  interval     = 1
  time_zone    = local.shutdown_tz

  schedule {
    at_these_hours   = [22]
    at_these_minutes = [0]
  }
}

resource "azurerm_logic_app_action_custom" "deallocate" {
  for_each = {
    win   = azurerm_windows_virtual_machine.win.id
    linux = azurerm_linux_virtual_machine.linux.id
  }

  name         = "deallocate-${each.key}"
  logic_app_id = azurerm_logic_app_workflow.nightly_shutdown.id

  body = jsonencode({
    type     = "Http"
    runAfter = {}
    inputs = {
      method = "POST"
      uri    = "https://management.azure.com${each.value}/deallocate?api-version=2024-07-01"
      authentication = {
        type     = "ManagedServiceIdentity"
        audience = "https://management.azure.com/"
      }
    }
  })
}

# Least privilege: the Logic App can manage VMs in this resource group only,
# not anything else in the subscription.
resource "azurerm_role_assignment" "shutdown_vm_contributor" {
  scope                = azurerm_resource_group.lab.id
  role_definition_name = "Virtual Machine Contributor"
  principal_id         = azurerm_logic_app_workflow.nightly_shutdown.identity[0].principal_id
}

# -----------------------------------------------------------------------------
# Azure Monitor Agent: collects logs on each VM and sends them to Sentinel
# -----------------------------------------------------------------------------

resource "azurerm_virtual_machine_extension" "ama_win" {
  name                       = "AzureMonitorWindowsAgent"
  virtual_machine_id         = azurerm_windows_virtual_machine.win.id
  publisher                  = "Microsoft.Azure.Monitor"
  type                       = "AzureMonitorWindowsAgent"
  type_handler_version       = "1.0"
  auto_upgrade_minor_version = true
  automatic_upgrade_enabled  = true
  tags                       = local.tags
}

resource "azurerm_virtual_machine_extension" "ama_linux" {
  name                       = "AzureMonitorLinuxAgent"
  virtual_machine_id         = azurerm_linux_virtual_machine.linux.id
  publisher                  = "Microsoft.Azure.Monitor"
  type                       = "AzureMonitorLinuxAgent"
  type_handler_version       = "1.0"
  auto_upgrade_minor_version = true
  automatic_upgrade_enabled  = true
  tags                       = local.tags
}

# -----------------------------------------------------------------------------
# Data collection rules: WHAT each agent collects and WHERE it sends it
# -----------------------------------------------------------------------------

resource "azurerm_monitor_data_collection_rule" "windows" {
  name                = "dcr-windows-security"
  location            = azurerm_resource_group.lab.location
  resource_group_name = azurerm_resource_group.lab.name
  kind                = "Windows"
  tags                = local.tags

  destinations {
    log_analytics {
      name                  = "sentinel-workspace"
      workspace_resource_id = azurerm_log_analytics_workspace.soc.id
    }
  }

  data_sources {
    # Windows Security log -> SecurityEvent table (logons, account changes, ...)
    windows_event_log {
      name           = "security-events"
      streams        = ["Microsoft-SecurityEvent"]
      x_path_queries = ["Security!*"]
    }

    # PowerShell operational log -> Event table (which commands ran)
    windows_event_log {
      name           = "powershell-events"
      streams        = ["Microsoft-Event"]
      x_path_queries = ["Microsoft-Windows-PowerShell/Operational!*"]
    }
  }

  data_flow {
    streams      = ["Microsoft-SecurityEvent"]
    destinations = ["sentinel-workspace"]
  }

  data_flow {
    streams      = ["Microsoft-Event"]
    destinations = ["sentinel-workspace"]
  }
}

resource "azurerm_monitor_data_collection_rule" "linux" {
  name                = "dcr-linux-auth"
  location            = azurerm_resource_group.lab.location
  resource_group_name = azurerm_resource_group.lab.name
  kind                = "Linux"
  tags                = local.tags

  destinations {
    log_analytics {
      name                  = "sentinel-workspace"
      workspace_resource_id = azurerm_log_analytics_workspace.soc.id
    }
  }

  data_sources {
    # Authentication logs (SSH logins, sudo) -> Syslog table
    syslog {
      name           = "auth-logs"
      facility_names = ["auth", "authpriv"]
      log_levels     = ["*"]
      streams        = ["Microsoft-Syslog"]
    }
  }

  data_flow {
    streams      = ["Microsoft-Syslog"]
    destinations = ["sentinel-workspace"]
  }
}

resource "azurerm_monitor_data_collection_rule_association" "windows" {
  name                    = "dcra-win-soc-01"
  target_resource_id      = azurerm_windows_virtual_machine.win.id
  data_collection_rule_id = azurerm_monitor_data_collection_rule.windows.id
}

resource "azurerm_monitor_data_collection_rule_association" "linux" {
  name                    = "dcra-lnx-soc-01"
  target_resource_id      = azurerm_linux_virtual_machine.linux.id
  data_collection_rule_id = azurerm_monitor_data_collection_rule.linux.id
}

# -----------------------------------------------------------------------------
# Outputs
# -----------------------------------------------------------------------------

output "windows_public_ip" {
  value = azurerm_public_ip.win.ip_address
}

output "linux_public_ip" {
  value = azurerm_public_ip.linux.ip_address
}

output "admin_username" {
  value = local.admin_username
}

output "windows_admin_password" {
  value     = random_password.windows_admin.result
  sensitive = true # hidden in normal output; read it with: terraform output -raw windows_admin_password
}
